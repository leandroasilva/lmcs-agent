# Keep the build context lean. The Dockerfile only needs sources, workspace
# manifests, the lockfile, and patches/ to run the filtered install.

# Version control
.git

# Dependencies and build artifacts (rebuilt inside the container)
node_modules
**/node_modules
**/dist
**/dist-electron
.pnpm-store

# Vite build caches
.vite-hooks
**/.vite-plus

# Mobile build artifacts (not part of server image)
apps/mobile/.expo
apps/mobile/ios/build
apps/mobile/android/app/build
apps/mobile/android/.gradle

# Desktop app (server image does not include Electron)
apps/desktop

# Marketing site
apps/marketing

# Native Rust crates (not compiled in the Docker image)
native/*/target

# Release artifacts
release
release-cli
npm-packages

# Vendored read-only references (not imported by server build)
.repos

# Agent skills and dev container
.agents
.devcontainer

# Local dev state
.lmcs
.lmcs-agent

# OS and editor files
.DS_Store
*.log
.vscode
.idea

# Environment files (secrets should not be baked in)
.env
.env.*
!.env.example

# CI definitions (not needed inside the image)
.github

# Documentation (not needed in the image)
docs

# Packaging scripts (AUR, etc.)
packaging
