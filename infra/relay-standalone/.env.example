# LMCS Relay Standalone Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database (MySQL)
DATABASE_URL=mysql://lmcs_relay:password@db:3306/lmcs_relay
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_USER=lmcs_relay
DATABASE_PASSWORD=password
DATABASE_NAME=lmcs_relay

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Relay Configuration
RELAY_DOMAIN=agent.lmcs.tec.br
RELAY_TUNNEL_DOMAIN=tunnels.lmcs.tec.br

# Cloudflare Tunnel (optional - for managed tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*
