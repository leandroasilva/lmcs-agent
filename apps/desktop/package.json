{
  "name": "@lmcstools/desktop",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "main": "dist-electron/boot.cjs",
  "scripts": {
    "ensure:electron": "node scripts/ensure-electron-runtime.mjs",
    "start": "node scripts/start-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run --passWithNoTests",
    "smoke-test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@clerk/electron": "catalog:",
    "@clerk/electron-passkeys": "catalog:",
    "@crowecawcaw/xa11y": "0.13.0",
    "@effect/platform-node": "catalog:",
    "@lmcstools/client": "workspace:*",
    "@lmcstools/core": "workspace:*",
    "@lmcstools/network": "workspace:*",
    "@napi-rs/keyring": "^1.3.0",
    "dbus-next": "0.10.2",
    "effect": "catalog:",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "ffi-rs": "1.3.2",
    "playwright-core": "1.60.0",
    "react-grab": "^0.1.32"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "acorn": "8.16.0",
    "cross-env": "^10.1.0",
    "electron": "44.4.2",
    "electron-builder": "26.15.6",
    "tailwindcss": "catalog:",
    "vite-plus": "catalog:"
  },
  "build": {
    "appId": "br.net.hcloud.lmcs-agent",
    "artifactName": "LMCS-Code-${version}-${arch}-${os}.${ext}",
    "files": [
      "dist-electron/**/*",
      "app-update.yml",
      "latest*.yml",
      "latest*.yml.blockmap",
      "!node_modules"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "../../assets/prod/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "executableName": "lmcs-code"
    },
    "publish": {
      "provider": "github",
      "owner": "leandroasilva",
      "repo": "lmcs-agent",
      "releaseType": "release"
    }
  },
  "productName": "LMCS Code (Alpha)"
}
