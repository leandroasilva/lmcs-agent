---
import { getImage } from "astro:assets";
import desktopScreenshot from "../assets/app-desktop-real.png";
import Layout from "../layouts/Layout.astro";
import {
  DOWNLOAD_URL,
  GITHUB_REPOSITORY_URL,
} from "../lib/site";

const screenshot = await getImage({
  src: desktopScreenshot,
  widths: [864, 1180, 1728, 2360],
  format: "webp",
  quality: 90,
});
---

<Layout>
  <!-- ── Hero Section ──────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-container">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="hero-title-gradient">LMCS Code</span>
        </h1>
        <p class="hero-subtitle">
          Editor de código com inteligência artificial para times que entregam. Escreva, depure e implante mais rápido com assistência inteligente.
        </p>
        <div class="hero-actions">
          <a href={DOWNLOAD_URL} class="btn btn-primary btn-lg">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.3l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.12l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.3z"/>
            </svg>
            Download para macOS
          </a>
          <a href={GITHUB_REPOSITORY_URL} class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">
            <svg class="btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            Ver no GitHub
          </a>
        </div>
      </div>

      <div class="hero-preview">
        <div class="hero-screenshot-frame">
          <div class="screenshot-overlay" aria-hidden="true"></div>
          <picture>
            <source
              media="(max-width: 820px)"
              srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
            />
            <img
              src={desktopScreenshot.src}
              srcset={`${screenshot.srcSet.attribute}, ${desktopScreenshot.src} ${desktopScreenshot.width}w`}
              sizes="(max-width: 960px) min(864px, calc(100vw - 20px)), min(1180px, calc(100vw - 60px))"
              alt="LMCS Code - Interface do editor de código com IA"
              width={desktopScreenshot.width}
              height={desktopScreenshot.height}
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features Section ─────────────────────────────────────── -->
  <section class="features" id="features">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Tudo que você precisa para entregar mais rápido</h2>
        <p class="section-subtitle">
          Um ambiente completo de desenvolvimento com assistência de inteligência artificial integrada.
        </p>
      </div>

      <div class="features-grid">
        <!-- Feature 1: AI Chat -->
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3 class="feature-title">Chat com IA</h3>
          <p class="feature-description">
            Faça perguntas, receba sugestões de código e depure problemas com linguagem natural. Múltiplos provedores de IA suportados.
          </p>
        </div>

        <!-- Feature 2: Code Editor -->
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"/>
              <polyline points="8 6 2 12 8 18"/>
            </svg>
          </div>
          <h3 class="feature-title">Editor de Código Integrado</h3>
          <p class="feature-description">
            Editor Monaco integrado. Edite arquivos diretamente no app com destaque de sintaxe e IntelliSense.
          </p>
        </div>

        <!-- Feature 3: File Explorer -->
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3 class="feature-title">Explorador de Arquivos</h3>
          <p class="feature-description">
            Navegue pela estrutura do seu projeto com facilidade. Abra, edite e gerencie arquivos diretamente pela interface.
          </p>
        </div>

        <!-- Feature 4: Terminal -->
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="4 17 10 11 4 5"/>
              <line x1="12" y1="19" x2="20" y2="19"/>
            </svg>
          </div>
          <h3 class="feature-title">Terminal Integrado</h3>
          <p class="feature-description">
            Execute comandos, scripts e processos de build sem sair do editor. Emulação completa de terminal.
          </p>
        </div>

        <!-- Feature 5: Browser Preview -->
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="feature-title">Preview no Browser</h3>
          <p class="feature-description">
            Visualize aplicações web diretamente no app. Teste e depure seu código frontend em tempo real.
          </p>
        </div>

        <!-- Feature 6: Git Integration -->
        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="18" r="3"/>
              <circle cx="6" cy="6" r="3"/>
              <path d="M6 21V9a9 9 0 0 0 9 9"/>
            </svg>
          </div>
          <h3 class="feature-title">Integração Git</h3>
          <p class="feature-description">
            Crie commits, branches e pull requests diretamente do editor. Integração completa com GitHub.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Multi-Provider Section ────────────────────────────────── -->
  <section class="providers" id="providers">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Sua IA, sua escolha</h2>
        <p class="section-subtitle">
          Conecte seus provedores de IA favoritos. Traga suas próprias chaves de API e assinaturas.
        </p>
      </div>

      <div class="providers-grid">
        <div class="provider-card">
          <h3 class="provider-name">Qoder</h3>
          <p class="provider-description">Assistente de código com IA com compreensão avançada de código e geração automatizada</p>
        </div>
        <div class="provider-card">
          <h3 class="provider-name">CommandCode</h3>
          <p class="provider-description">Análise inteligente de código e capacidades de refatoração automatizada</p>
        </div>
        <div class="provider-card">
          <h3 class="provider-name">Claude Code</h3>
          <p class="provider-description">Claude da Anthropic para compreensão e geração de código sofisticadas</p>
        </div>
        <div class="provider-card">
          <h3 class="provider-name">Codex</h3>
          <p class="provider-description">Codex da OpenAI para assistência e automação versátil de código</p>
        </div>
        <div class="provider-card">
          <h3 class="provider-name">Cursor</h3>
          <p class="provider-description">Editor de código AI-first com autocomplete inteligente e chat</p>
        </div>
        <div class="provider-card">
          <h3 class="provider-name">Grok</h3>
          <p class="provider-description">Grok da xAI para assistência e análise de código em tempo real</p>
        </div>
        <div class="provider-card">
          <h3 class="provider-name">OpenCode</h3>
          <p class="provider-description">Assistente de código open-source com fluxos de trabalho personalizáveis</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Download Section ──────────────────────────────────────── -->
  <section class="download" id="download">
    <div class="container">
      <div class="download-content">
        <h2 class="download-title">Pronto para entregar mais rápido?</h2>
        <p class="download-subtitle">
          Baixe o LMCS Code e comece a construir com assistência de IA hoje mesmo.
        </p>
        <div class="download-actions">
          <a href={DOWNLOAD_URL} class="btn btn-primary btn-lg">
            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.3l2.9 5.88 6.49.94-4.7 4.58 1.11 6.47L12 17.12l-5.8 3.05 1.11-6.47-4.7-4.58 6.49-.94L12 2.3z"/>
            </svg>
            Download para macOS
          </a>
          <a href={GITHUB_REPOSITORY_URL} class="btn btn-secondary btn-lg" target="_blank" rel="noopener noreferrer">
            <svg class="btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
            Ver no GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Footer ────────────────────────────────────────────────── -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h3 class="footer-brand-name">LMCS Code</h3>
          <p class="footer-brand-description">
            Editor de código com IA para times que entregam.
          </p>
        </div>
        <div class="footer-links">
          <h4 class="footer-links-title">Produto</h4>
          <ul class="footer-links-list">
            <li><a href="#features">Recursos</a></li>
            <li><a href="#providers">Provedores</a></li>
            <li><a href={DOWNLOAD_URL}>Download</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h4 class="footer-links-title">Recursos</h4>
          <ul class="footer-links-list">
            <li><a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a></li>
            <li><a href="/privacy-policy">Política de Privacidade</a></li>
            <li><a href="/terms-of-service">Termos de Serviço</a></li>
          </ul>
        </div>
        <div class="footer-links">
          <h4 class="footer-links-title">Conecte-se</h4>
          <ul class="footer-links-list">
            <li><a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="footer-copyright">
          © 2026 LMCS Tools. Todos os direitos reservados.
        </p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* ── Hero Section ─────────────────────────────────────────── */
  .hero {
    padding: 8rem 0 4rem;
    background: linear-gradient(180deg, #0a0a0a 0%, #1a1a1a 100%);
    overflow: hidden;
  }

  .hero-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }

  .hero-content {
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-title-gradient {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-platforms {
    color: #666;
    font-size: 0.875rem;
  }

  .hero-platforms a {
    color: #667eea;
    text-decoration: none;
    transition: color 0.2s;
  }

  .hero-platforms a:hover {
    color: #764ba2;
  }

  .hero-platforms .separator {
    margin: 0 0.5rem;
    color: #444;
  }

  .hero-preview {
    margin-top: 4rem;
  }

  .hero-screenshot-frame {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
  }

  .screenshot-overlay {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent 0%, rgba(10, 10, 10, 0.85) 30%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-screenshot-frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Buttons ──────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -5px rgba(102, 126, 234, 0.4);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }

  .btn-icon {
    width: 20px;
    height: 20px;
  }

  /* ── Features Section ─────────────────────────────────────── */
  .features {
    padding: 6rem 0;
    background: #0a0a0a;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .section-subtitle {
    font-size: 1.25rem;
    color: #a0a0a0;
    max-width: 600px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 2rem;
    transition: all 0.3s;
  }

  .feature-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(102, 126, 234, 0.3);
    transform: translateY(-4px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .feature-icon svg {
    width: 24px;
    height: 24px;
    color: white;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: white;
    margin-bottom: 0.75rem;
  }

  .feature-description {
    color: #a0a0a0;
    line-height: 1.6;
    font-size: 0.9375rem;
  }

  /* ── Providers Section ────────────────────────────────────── */
  .providers {
    padding: 6rem 0;
    background: linear-gradient(180deg, #0a0a0a 0%, #1a1a1a 100%);
  }

  .providers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .provider-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 1.5rem;
    transition: all 0.3s;
  }

  .provider-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(102, 126, 234, 0.3);
  }

  .provider-name {
    font-size: 1.125rem;
    font-weight: 600;
    color: white;
    margin-bottom: 0.5rem;
  }

  .provider-description {
    color: #a0a0a0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* ── Download Section ─────────────────────────────────────── */
  .download {
    padding: 6rem 0;
    background: #0a0a0a;
    text-align: center;
  }

  .download-content {
    max-width: 700px;
    margin: 0 auto;
  }

  .download-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }

  .download-subtitle {
    font-size: 1.25rem;
    color: #a0a0a0;
    margin-bottom: 2.5rem;
  }

  .download-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .download-platforms {
    color: #666;
    font-size: 0.875rem;
  }

  .download-platforms a {
    color: #667eea;
    text-decoration: none;
  }

  .download-platforms a:hover {
    color: #764ba2;
  }

  .download-platforms .separator {
    margin: 0 0.5rem;
    color: #444;
  }

  /* ── Footer ───────────────────────────────────────────────── */
  .footer {
    padding: 4rem 0 2rem;
    background: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .footer-brand-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }

  .footer-brand-description {
    color: #a0a0a0;
    line-height: 1.6;
    max-width: 300px;
  }

  .footer-links-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .footer-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links-list li {
    margin-bottom: 0.75rem;
  }

  .footer-links-list a {
    color: #a0a0a0;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .footer-links-list a:hover {
    color: #667eea;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
  }

  .footer-copyright {
    color: #666;
    font-size: 0.875rem;
  }

  /* ── Responsive ──────────────────────────────────────────── */
  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0 2rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: center;
    }

    .btn-lg {
      width: 100%;
      max-width: 300px;
      justify-content: center;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .providers-grid {
      grid-template-columns: 1fr;
    }

    .footer-grid {
