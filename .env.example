# LMCS Code Environment Configuration
# Copy to .env: `cp .env.example .env`

# =============================================================================
# LMCS Connect (Cloud Features)
# =============================================================================
# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
LMCS_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
LMCS_CLERK_JWT_TEMPLATE=lmcs-relay
LMCS_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Production relay URL. For self-hosted, see infra/relay.
LMCS_RELAY_URL=https://relay.t3.codes

# Optional: hosted app origin for CLI OAuth flow
# LMCS_HOSTED_APP_URL=https://nightly.app.t3.codes

# =============================================================================
# macOS Signing (Optional)
# =============================================================================
# LMCS_APPLE_TEAM_ID=ABC1234567
# LMCS_MACOS_PROVISIONING_PROFILE=/absolute/path/to/lmcs.provisionprofile
# LMCS_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# =============================================================================
# Mobile Telemetry (Optional)
# =============================================================================
# LMCS_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# LMCS_MOBILE_OTLP_TRACES_DATASET=lmcs-code-mobile-traces-dev
# LMCS_MOBILE_OTLP_TRACES_TOKEN=xaat-...

# =============================================================================
# Development Overrides
# =============================================================================
# Reusable dev auth token (see docs/operations/development.md)
# LMCS_DEV_AUTH_TOKEN=your-token-here

# Custom data directory (default: ~/.lmcs)
# LMCS_HOME=/path/to/data

# Server port (default: 13773)
# LMCS_PORT=13773

# Disable auto-update in production
# LMCS_DISABLE_AUTO_UPDATE=1

# =============================================================================
# Legacy (Deprecated) - For backward compatibility only
# =============================================================================
# T3CODE_HOME, T3CODE_PORT, T3CODE_DISABLE_AUTO_UPDATE, T3CODE_DEV_AUTH_TOKEN
# These are deprecated. Use LMCS_* variables instead.
